generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FamilyStatus {
  NEW
  RETURNING
}

enum RuleActionType {
  DOCUMENT_REQUEST
}

enum DocumentStatus {
  PENDING
  REQUESTED
  SUBMITTED
  APPROVED
  REJECTED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum RuleType {
  APPLICATION
  PAYMENT
  NOTIFICATION
}

model School {
  id           String        @id @default(uuid())
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
}

model Application {
  id               String            @id @default(uuid())
  schoolId         String
  school           School            @relation(fields: [schoolId], references: [id])
  familyStatus     FamilyStatus
  isBusinessOwner  Boolean           @default(false)
  filedUsTaxes2021 Boolean           @default(false)
  documentRequests DocumentRequest[]
  ruleAudits       RuleAudit[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  status           ApplicationStatus @default(DRAFT)

  student   Student @relation(fields: [studentId], references: [id])
  studentId String
}

model Document {
  id        String            @id @default(uuid())
  name      String            @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  url       String?
  requests  DocumentRequest[]
}

model DocumentRequest {
  id            String         @id @default(uuid())
  applicationId String
  application   Application    @relation(fields: [applicationId], references: [id])
  documentId    String
  document      Document       @relation(fields: [documentId], references: [id])
  status        DocumentStatus @default(PENDING)
  requestedAt   DateTime       @default(now())
  submittedAt   DateTime?
  updatedAt     DateTime?      @updatedAt

  @@unique([applicationId, documentId])
}

model Family {
  id        String    @id @default(uuid())
  parentA   Parent    @relation("ParentA", fields: [parentAId], references: [id])
  parentAId String    @unique
  parentB   Parent?   @relation("ParentB", fields: [parentBId], references: [id])
  parentBId String?   @unique
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Parent {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String
  familyA   Family?  @relation("ParentA")
  familyB   Family?  @relation("ParentB")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id           String        @id @default(uuid())
  firstName    String
  lastName     String
  dob          DateTime
  familyId     String
  family       Family        @relation(fields: [familyId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
}

model Rule {
  id        String        @id @default(uuid())
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  versions  RuleVersion[]
}

model RuleVersion {
  id          String      @id @default(uuid())
  name        String
  description String?
  type        RuleType    @default(APPLICATION)
  ruleId      String
  version     Int
  ruleJson    Json // Stored as JSON array of condition objects
  createdAt   DateTime    @default(now())
  rule        Rule        @relation(fields: [ruleId], references: [id])
  ruleAudits  RuleAudit[]

  @@unique([ruleId, version])
}

model RuleAudit {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  ruleVersionId String
  ruleVersion   RuleVersion @relation(fields: [ruleVersionId], references: [id])
  evaluatedAt   DateTime    @default(now())
  matched       Boolean
}
