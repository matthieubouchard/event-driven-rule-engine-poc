{
  "openapi": "3.0.0",
  "paths": {
    "/api/rules": {
      "post": {
        "description": "Create version 0 of your first rule",
        "operationId": "RuleController_createRule",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRuleDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New rule id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Create a new rule",
        "tags": [
          "Rule"
        ]
      },
      "get": {
        "description": "An array of rules with the latest version",
        "operationId": "RuleController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Rules found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RuleDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Get all rules",
        "tags": [
          "Rule"
        ]
      }
    },
    "/api/rules/{id}": {
      "put": {
        "description": "Will create a new ruleVersion",
        "operationId": "RuleController_updateRule",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRuleDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated rule id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Update a rule by id",
        "tags": [
          "Rule"
        ]
      },
      "get": {
        "operationId": "RuleController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rule by id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuleDto"
                }
              }
            }
          }
        },
        "tags": [
          "Rule"
        ]
      },
      "delete": {
        "operationId": "RuleController_softDelete",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deactivate a rule by id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Rule"
        ]
      }
    },
    "/api/preview-count": {
      "post": {
        "operationId": "RuleEvaluationController_getMatchingApplicationsCount",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RuleConditionsInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Get count of applications matching rule conditions",
        "tags": [
          "RuleEvaluation"
        ]
      }
    },
    "/api/document": {
      "get": {
        "operationId": "DocumentController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Document"
        ]
      }
    },
    "/api/notification/sse": {
      "get": {
        "operationId": "NotificationController_connect",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Notification"
        ]
      }
    },
    "/api/application": {
      "get": {
        "operationId": "ApplicationController_findAll",
        "parameters": [],
        "responses": {
          "default": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApplicationResponseDto"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Application"
        ]
      }
    },
    "/api/application/{id}": {
      "post": {
        "operationId": "ApplicationController_processApplication",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericMutationResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Application"
        ]
      }
    }
  },
  "info": {
    "title": "Rules Engine API",
    "description": "API documentation for the Rules Engine",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "rules",
      "description": "Rule management endpoints"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RuleConditionFact": {
        "type": "string",
        "enum": [
          "familyStatus",
          "isBusinessOwner",
          "filedUsTaxes2021"
        ]
      },
      "FamilyStatusEnum": {
        "type": "string",
        "enum": [
          "NEW",
          "RETURNING"
        ]
      },
      "FamilyStatusCondition": {
        "type": "object",
        "properties": {
          "fact": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RuleConditionFact"
              }
            ]
          },
          "value": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FamilyStatusEnum"
              }
            ]
          }
        },
        "required": [
          "fact",
          "value"
        ]
      },
      "BusinessOwnerCondition": {
        "type": "object",
        "properties": {
          "fact": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RuleConditionFact"
              }
            ]
          },
          "value": {
            "type": "boolean"
          }
        },
        "required": [
          "fact",
          "value"
        ]
      },
      "Filed2021Condition": {
        "type": "object",
        "properties": {
          "fact": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RuleConditionFact"
              }
            ]
          },
          "value": {
            "type": "boolean"
          }
        },
        "required": [
          "fact",
          "value"
        ]
      },
      "Action": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "DOCUMENT_REQUEST"
            ],
            "default": "DOCUMENT_REQUEST"
          },
          "value": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "CreateRuleDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "APPLICATION",
              "PAYMENT",
              "NOTIFICATION"
            ],
            "default": "APPLICATION"
          },
          "conditions": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/FamilyStatusCondition"
                },
                {
                  "$ref": "#/components/schemas/BusinessOwnerCondition"
                },
                {
                  "$ref": "#/components/schemas/Filed2021Condition"
                }
              ],
              "discriminator": {
                "propertyName": "fact"
              }
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Action"
            }
          }
        },
        "required": [
          "name",
          "description",
          "type",
          "conditions",
          "actions"
        ]
      },
      "RuleVersionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "APPLICATION",
              "PAYMENT",
              "NOTIFICATION"
            ]
          },
          "ruleJson": {
            "type": "object",
            "properties": {
              "conditions": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/FamilyStatusCondition"
                    },
                    {
                      "$ref": "#/components/schemas/BusinessOwnerCondition"
                    },
                    {
                      "$ref": "#/components/schemas/Filed2021Condition"
                    }
                  ]
                }
              },
              "actions": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Action"
                }
              }
            },
            "required": [
              "conditions",
              "actions"
            ]
          }
        },
        "required": [
          "id",
          "version",
          "name",
          "description",
          "type"
        ]
      },
      "RuleDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RuleVersionDto"
            }
          }
        },
        "required": [
          "id",
          "versions"
        ]
      },
      "RuleConditionsInput": {
        "type": "object",
        "properties": {
          "conditions": {
            "items": {
              "type": "array"
            },
            "type": "array"
          }
        },
        "required": [
          "conditions"
        ]
      },
      "StudentDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "dob": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "dob"
        ]
      },
      "SchoolDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "RuleVersionName": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "version",
          "name"
        ]
      },
      "RuleAuditDto": {
        "type": "object",
        "properties": {
          "ruleVersion": {
            "$ref": "#/components/schemas/RuleVersionName"
          },
          "matched": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "evaluatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "ruleVersion",
          "matched",
          "id",
          "evaluatedAt"
        ]
      },
      "DocumentDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "DocumentRequestDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "requestedAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "REQUESTED",
              "SUBMITTED",
              "APPROVED",
              "REJECTED"
            ]
          },
          "document": {
            "$ref": "#/components/schemas/DocumentDto"
          }
        },
        "required": [
          "id",
          "requestedAt",
          "updatedAt",
          "status",
          "document"
        ]
      },
      "ApplicationResponseDto": {
        "type": "object",
        "properties": {
          "familyStatus": {
            "type": "string",
            "enum": [
              "NEW",
              "RETURNING"
            ]
          },
          "id": {
            "type": "string"
          },
          "isBusinessOwner": {
            "type": "boolean"
          },
          "filedUsTaxes2021": {
            "type": "boolean"
          },
          "student": {
            "$ref": "#/components/schemas/StudentDto"
          },
          "school": {
            "$ref": "#/components/schemas/SchoolDto"
          },
          "ruleAudits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RuleAuditDto"
            }
          },
          "documentRequests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentRequestDto"
            }
          }
        },
        "required": [
          "familyStatus",
          "id",
          "isBusinessOwner",
          "filedUsTaxes2021",
          "student",
          "school",
          "ruleAudits",
          "documentRequests"
        ]
      },
      "GenericMutationResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "message",
          "success"
        ]
      }
    }
  }
}